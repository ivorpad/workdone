[Unit]
Description=OpenAI Secure MCP Tunnel client for the OAuth (Events) listener of herdr-mcp
After=network-online.target herdr-mcp.service
Wants=network-online.target
Requires=herdr-mcp.service

[Service]
Type=simple
User=herdr-mcp
Group=herdr-mcp
# CONTROL_PLANE_API_KEY lives only here (mode 600, owned by herdr-mcp).
EnvironmentFile=/etc/herdr-mcp/tunnel.env
Environment=TUNNEL_CLIENT_PROFILE_DIR=/etc/herdr-mcp/tunnel-client
Environment=HOME=/var/lib/herdr-mcp
# The issuer is public and not tunneled; the client must be told it may fetch its metadata.
Environment=MCP_OAUTH_TRUSTED_ORIGINS=https://issuer.example.com
# The client probes the MCP server once when it starts and leaves the channel disabled
# if that fails. herdr-mcp takes a moment to listen after it starts, and restarting it
# restarts this unit too, so wait until it answers.
ExecStartPre=/bin/sh -c 'i=0; until /usr/bin/curl -fsS -o /dev/null -m 1 http://127.0.0.1:8789/healthz; do i=$$((i+1)); [ "$$i" -ge 30 ] && exit 1; sleep 1; done'
ExecStart=/opt/tunnel-client/tunnel-client run --profile herdr-mcp-events --log.level=info --log.format=json
Restart=always
RestartSec=5
StateDirectory=herdr-mcp

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
